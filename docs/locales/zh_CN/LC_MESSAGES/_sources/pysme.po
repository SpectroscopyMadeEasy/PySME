#: of pysme.abund:1
msgid "Elemental abundance data handling module"
msgstr ""

#: of pysme.abund.Abund:1
msgid "Bases: :py:class:`~pysme.persistence.IPersist`"
msgstr ""

#: of pysme.abund.Abund:1
msgid "Elemental abundance data and methods. Valid abundance pattern types are:"
msgstr ""

#: of pysme.abund.Abund:4
msgid "'sme' - For hydrogen, the abundance value is the fraction of all"
msgstr ""

#: of pysme.abund.Abund:5
msgid ""
"nuclei that are hydrogen, including all ionization states and treating "
"molecules as constituent atoms. For the other elements, the abundance "
"values are log10 of the fraction of nuclei of each element in any form "
"relative to the total for all elements in any form. For the Sun, the "
"abundance values of H, He, and Li are approximately 0.92, -1.11, and "
"-11.0."
msgstr ""

#: of pysme.abund.Abund:11
msgid "'n/nTot' - Abundance values are the fraction of nuclei"
msgstr ""

#: of pysme.abund.Abund:12
msgid ""
"of each element in any form relative to the total for all elements in any"
" form. For the Sun, the abundance values of H, He, and Li are "
"approximately 0.92, 0.078, and 1.03e-11."
msgstr ""

#: of pysme.abund.Abund:15
msgid "'n/nH' - Abundance values are the fraction of nuclei"
msgstr ""

#: of pysme.abund.Abund:16
msgid ""
"of each element in any form relative to the number of hydrogen nuclei in "
"any form. For the Sun, the abundance values of H, He, and Li are "
"approximately 1, 0.085, and 1.12e-11."
msgstr ""

#: of pysme.abund.Abund:20
msgid "'H=12' - Abundance values are log10 of the fraction of nuclei of"
msgstr ""

#: of pysme.abund.Abund:21
msgid ""
"each element in any form relative to the number of hydrogen in any form "
"plus an offset of 12. For the Sun, the nuclei abundance values of H, He, "
"and Li are approximately 12, 10.9, and 1.05."
msgstr ""

#: of pysme.abund.Abund.empty_pattern:1
msgid "Return an abundance pattern with value None for all elements."
msgstr ""

#: of pysme.abund.Abund.fromtype:1
msgid ""
"Return a copy of the input abundance pattern, transformed from the input "
"type to the 'H=12' type. Valid abundance pattern types are 'sme', "
"'n/nTot', 'n/nH', 'n/nFe', and 'H=12'."
msgstr ""

#: of pysme.abund.Abund.get_pattern:1
msgid ""
"Transform the specified abundance pattern from type used internally by "
"SME to the requested type. Valid abundance pattern types are: 'sme', "
"'n/nTot', 'n/nH', 'H=12'"
msgstr ""

#: ../../_sources/pysme.rst of pysme.util.load_bool_sparse
#: pysme.util.save_bool_sparse
msgid "Parameters"
msgstr ""

#: of pysme.abund.Abund.get_pattern:5
msgid ""
"The pattern format to retrieve the pattern as. Defaults to the original "
"input format."
msgstr ""

#: of pysme.abund.Abund.get_pattern:8
msgid ""
"If True will return the pattern as a numpy array, with indices as defined"
" in elem dict. Otherwise the return value is a dictionary, with the "
"elements as keys."
msgstr ""

#: of pysme.abund.Abund.set_pattern_by_name:1
msgid "Set the abundance pattern to one of the predefined options"
msgstr ""

#: of pysme.abund.Abund.set_pattern_by_name:3
msgid ""
"Name of the predefined option to use. One of: 'grevesse2007', "
"'asplund2009', 'asplund2021', 'asplund2005', 'lodders2003', 'anders1989',"
" 'grevesse1996', 'grevesse1998', ,'lodders2010', 'empty'"
msgstr ""

