#: ../../advance/line_filtering.md:110
msgid "Practical Guidance"
msgstr ""

#: ../../advance/line_filtering.md:112
msgid ""
"Start with `line_select_method=\"cdr\"` for continuity with existing CDR "
"workflows."
msgstr ""

#: ../../advance/line_filtering.md:113
msgid "For ALMAX, start with `line_select_almax_threshold = sme.accrt`."
msgstr ""

#: ../../advance/line_filtering.md:114
msgid ""
"Enable `line_select_almax_use_bins=True` when you want bin-wise "
"cumulative pruning."
msgstr ""

#: ../../advance/line_filtering.md:115
msgid ""
"Use `\"all\"` for short, narrow windows where filtering overhead may not "
"help."
msgstr ""

#: ../../advance/line_filtering.md:116
msgid "Use `\"dynamic\"` for wide ranges or many segments."
msgstr ""
